---
/** Fascia CTA color accento in fondo alle pagine. Il segno grafico (svg.gmark, 416x416, viewBox 64)
 *  sono i mattoni del marchio PROVVISORIO (scripts/marchio.mjs). [[DA COMPILARE: segno del logo vero]] */
import { site } from '../data/site';
import { cta } from '../data/contenuti';
---
<section class="cta section-sm"> <svg class="gmark" width="416" height="416" viewBox="0 0 64 64" fill="none" aria-hidden="true">  {[[4, 42, 26], [34, 42, 26], [4, 25, 12], [20, 25, 24], [48, 25, 12], [4, 8, 26], [34, 8, 26]].map(([x, y, w], i) => <rect x={x} y={y} width={w} height="14" stroke="currentColor" stroke-width="2.5" style={`--i:${i}`} />)} </svg> <div class="container"> <div class="narrow reveal"> <p class="eyebrow-light mb-2">{cta.eyebrow}</p> <h2 class="h2">{cta.titolo}</h2> <p class="lead mt-2" style="color: rgb(255 255 255 / 0.88)">{cta.testo}</p> <div class="btn-row mt-4"> <a href="/contatti/#richiesta" class="btn btn-primary">Contattaci</a> {site.telefono ? <a href={`tel:${site.telefonoE164}`} class="btn btn-outline-light">Chiama {site.telefono}</a> : <a href={`mailto:${site.email}`} class="btn btn-outline-light">{site.email}</a>} </div> </div> </div> </section>
