---
import { site } from '../data/site';
import { nav } from '../data/nav';
import { servizi } from '../data/servizi';
import { categorie } from '../data/progetti';
import Icon from './Icon.astro';
---
<footer class="site-footer"> <div class="container top"> <div> <a href="/" class="brand" aria-label={`${site.nome} — home`}><img src="/img/logo/logo-light.svg" width="882" height="182" alt={site.logoAlt} fetchpriority="auto" decoding="async"></a> <p class="mt-3" style="max-width: 22rem">{site.footerClaim}</p> {site.social.length > 0 && <div class="social"> {site.social.map((s) => <a href={s.url} target="_blank" rel="noopener me" aria-label={`${site.nome} su ${s.nome}`}><Icon name={s.icona} /></a>)} </div>} </div> <div> <h2>Impresa</h2> <ul> {nav.map((v) => <li><a href={v.href}>{v.label}</a></li>)} <li><a href="/mappa-del-sito/">Mappa del sito</a></li> </ul> </div> <div> <h2>Servizi</h2> <ul> {servizi.map((s) => <li><a href={`/servizi/#${s.id}`}>{s.nome}</a></li>)} </ul> <h2 class="mt-4">Lavori</h2> <ul> {categorie.map((c) => <li><a href={`/progetti/${c.slug}/`}>{c.nome}</a></li>)} </ul> </div> <div itemscope itemtype="https://schema.org/PostalAddress"> <h2>Contatti</h2> <address style="font-style: normal"> <p><strong style="color:#fff; font-weight:500">{site.nome}</strong></p> <p><span itemprop="streetAddress">{site.indirizzo.via}</span><br><span itemprop="postalCode">{site.indirizzo.cap}</span> <span itemprop="addressLocality">{site.indirizzo.citta}</span> (<span itemprop="addressRegion">{site.indirizzo.provincia}</span>), {site.indirizzo.paeseNome}</p> {site.telefono && <p class="mt-2"><a href={`tel:${site.telefonoE164}`}>Tel. {site.telefono}</a></p>} <p><a href={`mailto:${site.email}`}>{site.email}</a></p> </address> <a href={site.mapsUrl} target="_blank" rel="noopener" class="text-link mt-3" style="display:inline-block; color: var(--accent-on-dark)">Indicazioni per {site.indirizzo.citta}</a> </div> </div> <div class="container bottom"> <p>© {site.anno} {site.ragioneSociale || site.nome}{site.piva && <> · P.IVA {site.piva}</>}</p> <nav aria-label="Note legali"> <a href="/privacy-policy/">Privacy policy</a> <a href="/cookie-policy/">Cookie policy</a> <a href="/mappa-del-sito/">Mappa del sito</a> </nav> </div> </footer>
