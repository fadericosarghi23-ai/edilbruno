---
/** Icona a tratto del design system (viewBox 48). */
import { icone, type Icona } from '../data/icone';
interface Props { name: Icona; class?: string }
const { name, class: cls } = Astro.props;
---
<svg class={cls} viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><Fragment set:html={icone[name]} /></svg>
