---
/**
 * <picture> come nel sito sorgente: sorgenti avif + webp con srcset/sizes e fallback <img>
 * con width/height intrinseci. Per i segnaposto SVG (e le foto senza varianti) esce solo l'<img>.
 */
import { variants, type Img } from '../lib/media';

interface Props {
  img: Img;
  sizes?: string;
  eager?: boolean;
  class?: string;
}
const { img, sizes = '100vw', eager = false, class: cls } = Astro.props;
const v = variants(img);
---
<picture>{v && <><source type="image/avif" srcset={v.avif} sizes={sizes} /><source type="image/webp" srcset={v.webp} sizes={sizes} /></>}<img src={img.src} alt={img.alt} width={img.width} height={img.height} loading={eager ? 'eager' : 'lazy'} decoding={eager ? 'sync' : 'async'} fetchpriority={eager ? 'high' : 'auto'} class={cls} /></picture>
